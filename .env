# API hosts: first value = staging, second value = production.
VITE_API_BASE_URL=["https://api.backoffice.staging.betkraft.co.uk","https://api.backoffice.betkraft.co.uk"]

# Top game groups shown in the "Add operator game" dialog.
# Each inner array is one group of game ids, e.g. [[9,5],[3,11]].
VITE_TOP_GAME_IDS=[[9,5],[3,11]]

# Game ids that behave as jackpots (stake, total games, min/max payout only).
VITE_JACKPOT_GAMES=[]
VITE_JACKPOT_FIELDS=stake,total_games,minimum_win,maximum_win

# Game ids that expose the per-currency denomination editor.
VITE_DENOMINATION_GAMES=[]
